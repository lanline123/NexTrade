{
  "name": "tigshop-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TigShop 前端 workspace（pc-semi 商城端；admin-semi 独立 npm 管理）",
  "scripts": {
    "dev:pc-semi": "pnpm --filter @tigshop/pc-semi dev",
    "build:pc-semi": "pnpm --filter @tigshop/pc-semi build",
    "build": "pnpm -r build",
    "check:contract": "python ../tools/check_frontend.py contract --strict",
    "check:doc": "python ../tools/verify_frontend_doc.py"
  },
  "engines": {
    "node": ">=20"
  }
}